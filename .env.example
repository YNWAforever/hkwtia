# Public site
NEXT_PUBLIC_SITE_URL=

# Neon Postgres and Neon Auth
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Isolated Neon database used by migration tests and destructive acceptance resets
DATABASE_URL_TEST=
# M4A database acceptance is opt-in and must target the isolated DATABASE_URL_TEST
RUN_DATABASE_TESTS=
# M3 destructive acceptance only: use the exact sentinel isolated-preview
M3_ACCEPTANCE_ALLOW_DESTRUCTIVE=
# Exact normalized Neon hostname parsed from DATABASE_URL_TEST
M3_ACCEPTANCE_EXPECTED_DB_HOST=
# Required explicit timezone-bearing instant for deterministic M3 seed scheduling
M3_SEED_NOW=
# M3 fixtures are isolated-only, like M5 and M6
M3_ACCEPTANCE_SEED=
# M2 demo fixtures (npm run db:seed:demo / db:seed:m2) are isolated-only too
DEMO_ACCEPTANCE_SEED=
# M4a/M4b/M4c fixtures are isolated-only too. M4A_ACCEPTANCE_SEED gates
# db:seed:m4a, which reconciles a synthetic member and two fictional events.
# It does NOT gate db:seed:m4a-knowledge — that command loads only the real
# funding-scheme sources, needs no flag, and is safe in production.
M4A_ACCEPTANCE_SEED=
M4B_ACCEPTANCE_SEED=
M4C_ACCEPTANCE_SEED=
# Both allowlists must match the provider project and DATABASE_URL_TEST hostname
M2_TEST_NEON_PROJECT_ID=
M2_TEST_NEON_HOST=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
M2_TEST_STAFF_EMAIL=
M2_TEST_STAFF_PASSWORD=
M2_TEST_MEMBER_EMAIL=
M2_TEST_MEMBER_PASSWORD=
M2_TEST_COMPANY_ADMIN_EMAIL=
M2_TEST_COMPANY_ADMIN_PASSWORD=

# Isolated M3 Preview browser acceptance; configure values outside the repository
# Required for remote runs; set to the exact HTTPS Vercel Preview origin
M3_E2E_ALLOWED_ORIGIN=
PLAYWRIGHT_BASE_URL=
VERCEL_SHARE_TOKEN=
# WP-8 read-only Preview runs: a Vercel share URL becomes an ignored browser session via
# `node scripts/vercel-preview-session.mjs`; point Playwright and Lighthouse at its outputs.
VERCEL_SHARE_URL=
PLAYWRIGHT_STORAGE_STATE=
LHCI_COOKIE_FILE=
M3_TEST_STAFF_EMAIL=
M3_TEST_STAFF_PASSWORD=
M3_TEST_MEMBER_EMAIL=
M3_TEST_MEMBER_PASSWORD=
# Generate these one-time confirmation tokens from the matching Preview signing secret
M3_TEST_UNSUBSCRIBE_TOKEN_EN=
M3_TEST_UNSUBSCRIBE_TOKEN_ZH_HK=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTUP_PRICE_ID=
STRIPE_CORPORATE_PRICE_ID=
# Stripe test-mode values for isolated acceptance/preview verification
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_STARTUP_PRICE_ID=
STRIPE_TEST_CORPORATE_PRICE_ID=

# Email delivery (configure only a verified sender domain)
RESEND_API_KEY=
EMAIL_FROM=
# Preview-only deterministic transport; production must use resend
EMAIL_DELIVERY_MODE=

# AI-Ops providers and models
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# The Concierge is enabled only by the exact lowercase value true
AGENTS_ENABLED=false
AGENT_MODEL_CONCIERGE=openai:gpt-4.1-mini
# A dedicated model for the portal AI writers, so changing the concierge's model
# does not silently change them. Optional; defaults to the value below.
AGENT_MODEL_WRITER=openai:gpt-4.1-mini
AGENT_MODEL_ANALYST=
CONCIERGE_COOKIE_SECRET=
# Local production-build acceptance only. Never enable on Vercel; both flags, loopback APP_URL, and the matching request origin are required.
M4A_DETERMINISTIC_ACCEPTANCE=false
M4A_DETERMINISTIC_ACCEPTANCE_AUTHORIZED=false
# Live AI evals require all three values plus a provider key
RUN_LIVE_AI_EVALS=false
RUN_LIVE_EVALS=
LIVE_AI_EVALS_AUTHORIZED=false

# Scheduled jobs, unsubscribe signing, and founding-member pricing
# Required for shared auth (login/link sends), RSVP and ticket rate-limit keys; use a distinct random server secret (at least 32 UTF-8 bytes).
RATE_LIMIT_KEY_SECRET=
CRON_SECRET=
# Default off. Enable RSVP cancellation emails only after isolated acceptance and release approval.
# New admin batch writes and worker claims remain paused until isolated acceptance and staff approval.
ADMIN_BATCH_ENABLED=false
# Member imports also require the batch engine and an approved private staging policy.
MEMBER_IMPORT_ENABLED=false
# Finite profile grants require separate association approval before enabling.
MEMBERSHIP_GRANTS_ENABLED=false
# Separate approval for batch grants; profile-only capability remains default off.
MEMBERSHIP_GRANT_BATCH_ENABLED=false
# Staff pass resend uses the existing ticket outbox; default off for queueing and delivery.
TICKET_RESEND_BATCH_ENABLED=false
# Private, short-lived CSV downloads from confirmed member batch snapshots.
MEMBER_EXPORT_ENABLED=false
# Optional bounded operational settings. Defaults: 5000, 50, 5, 30 minutes.
ADMIN_BATCH_MAX_ITEMS=5000
ADMIN_BATCH_CLAIM_SIZE=50
ADMIN_BATCH_MAX_ATTEMPTS=5
ADMIN_BATCH_PREVIEW_TTL_MINUTES=30
EVENT_CANCELLATION_NOTICES_ENABLED=false
# Distinct from CRON_SECRET: a bearer credential must not double as a signing key
UNSUBSCRIBE_TOKEN_SECRET=
# Signs per-seat ticket pass tokens. Required where passes are issued or read.
TICKET_PASS_TOKEN_SECRET=
FOUNDING_DEADLINE=
APP_URL=

# Cloudflare R2 object storage
R2_ACCOUNT_ID=
# One of: default, eu, us, fedramp. Must match the existing private bucket.
R2_JURISDICTION=default
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_R2_PUBLIC_URL=

# WOZTELL WhatsApp adapter
WOZTELL_API_TOKEN=
WOZTELL_CHANNEL_ID=
WOZTELL_WEBHOOK_SECRET=
# Live delivery and acceptance are separately authorized.
# RUN_LIVE_WOZTELL is parsed by aiEnv() as "0" | "1" (C-9): blank means not
# live, and anything else — `true`, `yes`, `TRUE` — is a startup error, because
# it used to mean "mock mode" while every send was recorded as delivered.
RUN_LIVE_WOZTELL=
RUN_LIVE_WOZTELL_ACCEPTANCE=
# Any key config/whatsapp-templates.ts declares; at least one is required when
# the separately authorized live acceptance run is enabled.
WOZTELL_ACCEPTANCE_APPROVED_TEMPLATE_KEYS=
# Fallback for one condition only: a `whatsapp_templates` registry with no rows
# at all. After migration 0034 seeds the nine keys it is inert.
WOZTELL_APPROVED_TEMPLATE_KEYS=
# Programme C-3 conversation-history backfill (/api/admin/woztell/backfill).
# Configuration, not a caller credential: the route authorises on the staff
# session and answers 503 BACKFILL_NOT_CONFIGURED while this is blank. Needs the
# Open API `api:admin` scope. The host and the GraphQL document it is used
# against are UNVERIFIED (plan O-2) — confirm both before pointing the route at
# production.
WOZTELL_OPEN_API_TOKEN=

# Optional Concierge bot protection. Set both or neither: the secret alone
# rejects every request because no client can mint a token, and the site key
# alone renders a challenge nothing verifies. Production refuses to start with
# only one of the pair set. The site key is public and is read at build time
# for statically prerendered pages, so changing it needs a rebuild.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Member tools (Phase D-2). The Content Calendar tool's access token is a secret and must
# never be committed with a value. Leave blank to render the tool as temporarily unavailable.
MEMBER_TOOL_CONTENT_CALENDAR_TOKEN=

# Optional observability
SENTRY_DSN=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# M5/M6 acceptance identities and the M6 database host allowlist
M5_ACCEPTANCE_EMAIL=
M5_ACCEPTANCE_PASSWORD=
M6_TEST_MEMBER_EMAIL=
M6_TEST_MEMBER_PASSWORD=
M6_TEST_STAFF_EMAIL=
M6_TEST_STAFF_PASSWORD=
M6_ACCEPTANCE_DATABASE_HOST_ALLOWLIST=
# D-4b passes acceptance fixtures (npm run db:seed:d4b) are isolated-only too,
# like M6: the flag, plus an exact hostname allowlist for the isolated database.
D4B_ACCEPTANCE_SEED=
D4B_ACCEPTANCE_DATABASE_HOST_ALLOWLIST=

# Requires separate approval of company grant policy; keep disabled until staging acceptance.
MEMBERSHIP_COMPANY_GRANTS_ENABLED=false

# Bulk reminders/invitations create reviewed campaign drafts; consent and locale gates remain.
MEMBER_COMMUNICATION_BATCH_ENABLED=false

# Aggregate web/job/worker metrics. Enabling logs is separate from enabling any alert delivery.
AUDIT_METRICS_ENABLED=false
# Set to the reviewed git SHA in the worker environment when logging is enabled.
WORKER_REVISION=

# Proposed defaults; approve retention policy before enabling the scrub worker.
MEMBER_IMPORT_RETENTION_ENABLED=false
MEMBER_IMPORT_UPLOAD_RETENTION_DAYS=7
MEMBER_IMPORT_STAGING_RETENTION_DAYS=30

# Private background attendee exports; activate only after isolated acceptance.
EVENT_ATTENDEE_EXPORT_ENABLED=false
EVENT_ATTENDEE_EXPORT_TTL_MINUTES=30

# Isolated audit browser identities and fixtures only; never production values.
M2_TEST_EXCO_EMAIL=
M2_TEST_EXCO_PASSWORD=
M2_TEST_SUPERADMIN_EMAIL=
M2_TEST_SUPERADMIN_PASSWORD=
HKWTIA_TEST_PENDING_MEMBERSHIP_ID=
HKWTIA_TEST_GUEST_CHECKIN_EVENT_ID=
HKWTIA_TEST_GUEST_CHECKIN_EMAIL=
HKWTIA_TEST_GUEST_CHECKIN_EMAIL_ZH=
HKWTIA_TEST_GUEST_RSVP_SLUG=

# Enable only after the isolated Google OAuth callback and trusted origins are verified.
AUTH_GOOGLE_ENABLED=false

# Manual replay of existing Stripe membership events; disabled until release approval.
PAYMENT_RECONCILIATION_ENABLED=false

# New terms flow needs an approved server registry version and release signoff.
MEMBERSHIP_POLICY_ACCEPTANCE_ENABLED=false
MEMBERSHIP_POLICY_ACTIVE_VERSION=

# Verified worker health: exact reviewed 40-char SHA, after migration0052 and deployed worker readback.
# Blank leaves worker health unknown; does not enable jobs or provider sends.
WORKER_HEALTH_REVISION=
# Optional exact existing job subset. Unset preserves existing schedules; "none" disables all.
# Worker uses WORKER_JOB_ALLOWLIST; web health uses the identical WORKER_HEALTH_JOBS readback.
# WORKER_HEALTH_JOBS=rate-limit-cleanup

# Renewal reconciliation operational bounds; server window derives existing90-day lead.
# Optional engineering limits, not association eligibility/renewal policy.
# RENEWAL_ENROLLMENT_PAGE_SIZE=250
# RENEWAL_ENROLLMENT_MAX_PAGES=20
# RENEWAL_ENROLLMENT_BUDGET_MS=6000

# Batch execution engineering budget per tick (1000..7000 ms; default 6000).
# ADMIN_BATCH_TIME_BUDGET_MS=6000

# Enable only after 0056 and isolated CMS publish/rollback acceptance.
CMS_SERVER_DRAFTS_ENABLED=false

# Reserved independent OpenCode Go credential name. Admin adoption is unapproved;
# the adapter rejects all calls even if a key is supplied. Never use OPENAI_API_KEY.
OPENCODE_GO_API_KEY=

# AI admission caps: owner-configured integer micro-USD; unset fails closed.
AI_BUDGET_RUN_MICROUSD=
AI_BUDGET_DAY_MICROUSD=
AI_BUDGET_MONTH_MICROUSD=

# Knowledge mutations stay off until 0058 and isolated acceptance. Policy owner must designate profile IDs.
AI_KNOWLEDGE_MANAGEMENT_ENABLED=false
AI_KNOWLEDGE_APPROVAL_PROFILE_IDS=

# Reviewed drafts require 0059 and isolated source/CAS/stale acceptance; approval never sends.
ADMIN_AI_DRAFTS_ENABLED=false

# Default-closed administrative application drafting; model route remains unapproved until its governance gate.
ADMIN_AI_APPLICATION_DRAFTS_ENABLED=false
ADMIN_AI_APPLICATION_MODEL=openai:gpt-4.1-mini

# T10: separate administrative-purpose/data approval; default off. No coding-key substitution.
ADMIN_AI_SUPPORT_DRAFTS_ENABLED=false
ADMIN_AI_SUPPORT_PROVIDER_APPROVED=false
ADMIN_AI_SUPPORT_MODEL=
# Independent encryption key; no Auth/Concierge reuse. Empty keeps inbox drafts in memory only.
INBOX_DRAFT_PROTECTION_ENABLED=false
INBOX_DRAFT_RETENTION_SECONDS=3600
INBOX_DRAFT_ENCRYPTION_SECRET=

# Engineering concurrency ceiling3; provider budget guards still apply per dispatch.
ADMIN_AI_RETENTION_CONCURRENCY=3

# T11: requires0060, approved renewal provider/budget and isolated worker acceptance.
ADMIN_AI_RETENTION_DRAFTS_ENABLED=false

# Administrative board/content generation stays off until capability-specific approval and budget verification.
ADMIN_AI_BOARD_DRAFTS_ENABLED=false
ADMIN_AI_CONTENT_DRAFTS_ENABLED=false
ADMIN_AI_CONTENT_PROVIDER_APPROVED=false
ADMIN_AI_CONTENT_MODEL=openai:gpt-4.1-mini
