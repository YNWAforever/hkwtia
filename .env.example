# Public site
NEXT_PUBLIC_SITE_URL=

# Neon Postgres and Neon Auth
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Isolated Neon database used by migration tests and destructive M2 acceptance resets
DATABASE_URL_TEST=
# M3 destructive acceptance only: use the exact sentinel isolated-preview
M3_ACCEPTANCE_ALLOW_DESTRUCTIVE=
# Exact normalized Neon hostname parsed from DATABASE_URL_TEST
M3_ACCEPTANCE_EXPECTED_DB_HOST=
# Required explicit timezone-bearing instant for deterministic M3 seed scheduling
M3_SEED_NOW=
# Both allowlists must match the provider project and DATABASE_URL_TEST hostname
M2_TEST_NEON_PROJECT_ID=
M2_TEST_NEON_HOST=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
M2_TEST_STAFF_EMAIL=
M2_TEST_STAFF_PASSWORD=
M2_TEST_MEMBER_EMAIL=
M2_TEST_MEMBER_PASSWORD=
M2_TEST_COMPANY_ADMIN_EMAIL=
M2_TEST_COMPANY_ADMIN_PASSWORD=

# Isolated M3 Preview browser acceptance; configure values outside the repository
# Required for remote runs; set to the exact HTTPS Vercel Preview origin
M3_E2E_ALLOWED_ORIGIN=
PLAYWRIGHT_BASE_URL=
VERCEL_SHARE_TOKEN=
M3_TEST_STAFF_EMAIL=
M3_TEST_STAFF_PASSWORD=
M3_TEST_MEMBER_EMAIL=
M3_TEST_MEMBER_PASSWORD=
# Generate these one-time confirmation tokens from the matching Preview signing secret
M3_TEST_UNSUBSCRIBE_TOKEN_EN=
M3_TEST_UNSUBSCRIBE_TOKEN_ZH_HK=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTUP_PRICE_ID=
STRIPE_CORPORATE_PRICE_ID=
# Stripe test-mode values for isolated acceptance/preview verification
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_STARTUP_PRICE_ID=
STRIPE_TEST_CORPORATE_PRICE_ID=

# Email delivery (configure only a verified sender domain)
RESEND_API_KEY=
EMAIL_FROM=
# Preview-only deterministic transport; production must use resend
EMAIL_DELIVERY_MODE=

# AI-Ops providers and models
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AGENTS_ENABLED=false
AGENT_MODEL_CONCIERGE=openai:gpt-4.1-mini
AGENT_MODEL_ANALYST=
CONCIERGE_COOKIE_SECRET=

# Scheduled jobs, unsubscribe signing, and founding-member pricing
CRON_SECRET=
FOUNDING_DEADLINE=
APP_URL=

# Cloudflare R2 object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_R2_PUBLIC_URL=

# WOZTELL WhatsApp adapter
WOZTELL_API_TOKEN=
WOZTELL_CHANNEL_ID=
WOZTELL_WEBHOOK_SECRET=

# Optional public-form protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_SECRET_KEY=

# Optional observability
SENTRY_DSN=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
